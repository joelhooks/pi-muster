#!/bin/sh
#   gate-tmp.sh ensure        create /Volumes/gate-tmp if missing; print its path
#   gate-tmp.sh claim PID     ensure, then make and print run-PID-<rand>/ under one lock
#   gate-tmp.sh release DIR   remove DIR; when no live run is left, detach the disk (frees its memory)
#   gate-tmp.sh run -- CMD    run CMD with TMPDIR=/Volumes/gate-tmp/run-<pid>-<rand>/,
#                             released after CMD exits; inherited TMPDIR if the disk is unavailable
#
# Switchboard, 2026-10-18: a RAM disk keeps every page a gate ever wrote; deleting files frees none. The disk held
# 16 GB for 3.7 days while using 158 MB. The last release detaches it, and the next claim recreates it (about a
# second). Every detach and recreate is logged with its timing, so a burst that keeps recreating it shows up.
set -u

volume_name=gate-tmp
root=/Volumes/$volume_name
sectors=${GATE_TMP_SECTORS:-33554432}
lock=${GATE_TMP_LOCK:-/tmp/muster-gate-tmp.lock}
log=${GATE_TMP_LOG:-${HOME:-/tmp}/.local/state/muster/gate-tmp.log}

ms() { perl -MTime::HiRes=time -e 'printf "%d", time * 1000' 2>/dev/null || echo 0; }

note() {
  mkdir -p "$(dirname "$log")" 2>/dev/null
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$log" 2>/dev/null
}

# One holder at a time across claim and release. A holder that died leaves its pid; the next caller takes over.
take_lock() {
  tries=0
  while ! mkdir "$lock" 2>/dev/null; do
    holder=$(cat "$lock/pid" 2>/dev/null)
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null && ! ps -p "$holder" -o pid= 2>/dev/null | grep -q '[0-9]'; then
      rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null
      continue
    fi
    tries=$((tries + 1))
    [ "$tries" -lt 300 ] || { fail "lock $lock held by ${holder:-unknown}"; return 1; }
    sleep 0.1
  done
  echo $$ > "$lock/pid"
}

drop_lock() { rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null; return 0; }

fail() {
  echo "gate-tmp: $*" >&2
  return 1
}

mounted_device() {
  mount | awk -v r="$root" '$2 == "on" && $3 == r { print $1 }'
}

is_ram_device() {
  hdiutil info | awk -v d="$1" '
    /^image-path/ { ram = ($3 ~ /^ram:\/\//) }
    $1 == d && ram { found = 1 }
    END { exit found ? 0 : 1 }'
}

create_disk() {
  dev=$(hdiutil attach -nobrowse -nomount "ram://$sectors" | awk 'NR == 1 { print $1 }') || return 1
  [ -n "$dev" ] || return 1
  if newfs_hfs -v "$volume_name" "$dev" >/dev/null &&
    diskutil mount "$dev" >/dev/null &&
    mkdir -p "$root/.fseventsd" &&
    touch "$root/.fseventsd/no_log" &&
    diskutil unmount "$dev" >/dev/null &&
    diskutil mount "$dev" >/dev/null; then
    return 0
  fi
  hdiutil detach "$dev" >/dev/null 2>&1
  return 1
}

ram_root() {
  [ ! -L "$root" ] && [ -d "$root" ] || return 1
  dev=$(mounted_device)
  [ -n "$dev" ] && is_ram_device "$dev"
}

sweep_dead_runs() {
  ram_root || { fail "refusing sweep: $root is not a RAM mount"; return 1; }
  for dir in "$root"/run-*; do
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    name=${dir#"$root"/}
    printf '%s\n' "$name" | grep -Eq '^run-[0-9]+-.+$' || continue
    pid=${name#run-}
    pid=${pid%%-*}
    # kill -0 failures also include permission errors. A visible process is not dead.
    if ! kill -0 "$pid" 2>/dev/null && ! ps -p "$pid" -o pid= 2>/dev/null | grep -q '[0-9]'; then
      ram_root || return 1
      rm -rf -- "$dir"
    fi
  done
}

ensure() {
  [ "$(uname -s)" = Darwin ] && [ "$(hostname -s | tr '[:upper:]' '[:lower:]')" = flagg ] || { fail "not Flagg macOS"; return 1; }
  [ ! -L "$root" ] || { fail "refusing symlink root"; return 1; }
  dev=$(mounted_device)
  if [ -z "$dev" ]; then
    started=$(ms)
    create_disk || { note "recreate failed"; fail "could not create the RAM disk at $root"; return 1; }
    dev=$(mounted_device)
    note "recreate dev=$dev ms=$(( $(ms) - started ))"
  fi
  is_ram_device "$dev" || { fail "$root is mounted from $dev, which is not a RAM disk"; return 1; }
  [ -e "$root/.fseventsd/no_log" ] || touch "$root/.fseventsd/no_log" 2>/dev/null
  mdutil -s "$root" 2>/dev/null | grep -q "Indexing disabled" || mdutil -i off "$root" >/dev/null 2>&1
  sweep_dead_runs || return 1
  echo "$root"
}

claim() {
  pid=${1:-}
  printf '%s\n' "$pid" | grep -Eq '^[0-9]+$' || { fail "usage: gate-tmp.sh claim PID"; return 2; }
  take_lock || return 1
  if out=$(ensure) && dir=$(mktemp -d "$out/run-$pid-XXXXXX"); then
    drop_lock
    echo "$dir"
    return 0
  fi
  drop_lock
  fail "${out:-could not claim a run directory}"
  return 1
}

live_runs() {
  for dir in "$root"/run-*; do
    [ -d "$dir" ] && [ ! -L "$dir" ] && return 0
  done
  return 1
}

# Detach only our RAM disk at its root, never forced: a busy device stays, and the next release tries again.
detach_if_idle() {
  ram_root || return 0
  sweep_dead_runs || return 0
  live_runs && return 0
  dev=$(mounted_device)
  started=$(ms)
  if hdiutil detach "$dev" >/dev/null 2>&1; then
    note "detach dev=$dev ms=$(( $(ms) - started ))"
  else
    # Switchboard, 2026-10-18: 21 orphaned `op daemon`s kept their cwd on the disk; name the holders.
    holders=$(lsof -Fpc "$root" 2>/dev/null | awk '/^p/ { pid = substr($0, 2) } /^c/ { if (!seen[pid]++) printf "%s%s:%s", (n++ ? " " : ""), substr($0, 2), pid }')
    note "detach busy dev=$dev held by ${holders:-unknown}"
  fi
}

release() {
  dir=${1:-}
  case "$dir" in
    "$root"/run-*) ;;
    *) fail "refusing release outside $root: $dir"; return 2 ;;
  esac
  take_lock || return 1
  if ram_root && [ -d "$dir" ] && [ ! -L "$dir" ]; then rm -rf -- "$dir"; fi
  detach_if_idle
  drop_lock
}

run() {
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || { fail "usage: gate-tmp.sh run -- CMD [ARGS...]"; exit 2; }
  run_dir=
  if out=$(claim $$); then
    run_dir=${out%/}
  fi
  if [ -z "$run_dir" ]; then
    echo "gate-tmp: WARNING RAM disk unavailable ($(printf '%s' "$out" | tr '\n' ' ')); running with inherited TMPDIR=${TMPDIR:-unset}" >&2
    exec "$@"
  fi
  trap 'release "$run_dir"' EXIT
  TMPDIR=$run_dir/ "$@" &
  child=$!
  trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
  while :; do
    wait "$child"
    code=$?
    kill -0 "$child" 2>/dev/null || break
  done
  exit "$code"
}

case "${1:-}" in
  ensure) take_lock || exit 1; ensure; code=$?; drop_lock; exit $code ;;
  claim) shift; claim "$@" ;;
  release) shift; release "$@" ;;
  run) shift; run "$@" ;;
  *) fail "usage: gate-tmp.sh ensure | claim PID | release DIR | run -- CMD [ARGS...]"; exit 2 ;;
esac
